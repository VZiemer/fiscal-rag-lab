{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Fiscal RAG Lab demo: private S3, CloudFront, HTTP API and read-only Lambda",
  "Parameters": {
    "CodeBucket": { "Type": "String" },
    "CodeKey": { "Type": "String" },
    "OriginSecret": { "Type": "String", "NoEcho": true, "MinLength": 32 },
    "PublicOrigin": { "Type": "String", "Default": "" }
  },
  "Resources": {
    "PublicFiles": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": { "BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true },
        "BucketEncryption": { "ServerSideEncryptionConfiguration": [{ "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }] }
      }
    },
    "LambdaRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [{ "PolicyName": "sanitized-logs-only", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["LambdaLogs", "Arn"] } }] } }]
      }
    },
    "LambdaLogs": { "Type": "AWS::Logs::LogGroup", "Properties": { "RetentionInDays": 7 } },
    "McpFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs22.x", "Handler": "index.handler", "Architectures": ["arm64"], "MemorySize": 1024, "Timeout": 28,
        "Role": { "Fn::GetAtt": ["LambdaRole", "Arn"] },
        "Code": { "S3Bucket": { "Ref": "CodeBucket" }, "S3Key": { "Ref": "CodeKey" } },
        "Environment": { "Variables": { "ORIGIN_SECRET": { "Ref": "OriginSecret" }, "MCP_CORPUS": "/var/task/corpus.json", "PUBLIC_ORIGIN": { "Ref": "PublicOrigin" } } },
        "LoggingConfig": { "LogGroup": { "Ref": "LambdaLogs" }, "LogFormat": "Text" }
      }
    },
    "HttpApi": { "Type": "AWS::ApiGatewayV2::Api", "Properties": { "Name": "fiscal-rag-lab-demo", "ProtocolType": "HTTP" } },
    "Integration": { "Type": "AWS::ApiGatewayV2::Integration", "Properties": {
      "ApiId": { "Ref": "HttpApi" }, "IntegrationType": "AWS_PROXY", "IntegrationUri": { "Fn::GetAtt": ["McpFunction", "Arn"] }, "PayloadFormatVersion": "2.0", "TimeoutInMillis": 29000
    } },
    "Route": { "Type": "AWS::ApiGatewayV2::Route", "Properties": { "ApiId": { "Ref": "HttpApi" }, "RouteKey": "$default", "Target": { "Fn::Join": ["/", ["integrations", { "Ref": "Integration" }]] } } },
    "Stage": { "Type": "AWS::ApiGatewayV2::Stage", "Properties": { "ApiId": { "Ref": "HttpApi" }, "StageName": "$default", "AutoDeploy": true, "DefaultRouteSettings": { "ThrottlingBurstLimit": 10, "ThrottlingRateLimit": 5 } } },
    "InvokePermission": { "Type": "AWS::Lambda::Permission", "Properties": {
      "Action": "lambda:InvokeFunction", "FunctionName": { "Ref": "McpFunction" }, "Principal": "apigateway.amazonaws.com",
      "SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*" }
    } },
    "S3Access": { "Type": "AWS::CloudFront::OriginAccessControl", "Properties": { "OriginAccessControlConfig": {
      "Name": { "Fn::Sub": "${AWS::StackName}-s3" }, "OriginAccessControlOriginType": "s3", "SigningBehavior": "always", "SigningProtocol": "sigv4"
    } } },
    "Distribution": { "Type": "AWS::CloudFront::Distribution", "Properties": { "DistributionConfig": {
      "Enabled": true, "Comment": "Fiscal RAG Lab read-only educational demo", "DefaultRootObject": "index.html", "HttpVersion": "http2", "PriceClass": "PriceClass_100",
      "Origins": [
        { "Id": "files", "DomainName": { "Fn::GetAtt": ["PublicFiles", "RegionalDomainName"] }, "OriginAccessControlId": { "Ref": "S3Access" }, "S3OriginConfig": { "OriginAccessIdentity": "" } },
        { "Id": "api", "DomainName": { "Fn::Sub": "${HttpApi}.execute-api.${AWS::Region}.amazonaws.com" }, "CustomOriginConfig": { "OriginProtocolPolicy": "https-only", "HTTPSPort": 443, "OriginSSLProtocols": ["TLSv1.2"] }, "OriginCustomHeaders": [{ "HeaderName": "x-fiscal-origin", "HeaderValue": { "Ref": "OriginSecret" } }] }
      ],
      "DefaultCacheBehavior": { "TargetOriginId": "files", "ViewerProtocolPolicy": "redirect-to-https", "AllowedMethods": ["GET", "HEAD"], "Compress": true, "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6" },
      "CacheBehaviors": [
        { "PathPattern": "/mcp", "TargetOriginId": "api", "ViewerProtocolPolicy": "https-only", "AllowedMethods": ["GET", "HEAD", "OPTIONS", "PUT", "PATCH", "POST", "DELETE"], "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad", "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac" },
        { "PathPattern": "/health", "TargetOriginId": "api", "ViewerProtocolPolicy": "https-only", "AllowedMethods": ["GET", "HEAD"], "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad", "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac" }
      ],
      "ViewerCertificate": { "CloudFrontDefaultCertificate": true }, "Restrictions": { "GeoRestriction": { "RestrictionType": "none" } }
    } } },
    "PublicFilesPolicy": { "Type": "AWS::S3::BucketPolicy", "Properties": { "Bucket": { "Ref": "PublicFiles" }, "PolicyDocument": { "Version": "2012-10-17", "Statement": [
      { "Effect": "Allow", "Principal": { "Service": "cloudfront.amazonaws.com" }, "Action": "s3:GetObject", "Resource": { "Fn::Sub": "${PublicFiles.Arn}/*" }, "Condition": { "StringEquals": { "AWS:SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}" } } } }
    ] } } }
  },
  "Outputs": {
    "DistributionId": { "Value": { "Ref": "Distribution" } },
    "Endpoint": { "Value": { "Fn::Sub": "https://${Distribution.DomainName}/mcp" } },
    "PublicOrigin": { "Value": { "Fn::Sub": "https://${Distribution.DomainName}" } },
    "PublicBucket": { "Value": { "Ref": "PublicFiles" } },
    "FunctionName": { "Value": { "Ref": "McpFunction" } },
    "ApiId": { "Value": { "Ref": "HttpApi" } }
  }
}
