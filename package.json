{
  "name": "fiscal-rag-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Educational RAG and custom vector index laboratory",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ingest": "npm run build && node dist/apps/ingestion-worker/src/main.js",
    "benchmark:vectors": "npm run build && node --expose-gc dist/scripts/benchmark-vectors.js",
    "start": "npm run build && node dist/apps/mcp-server/src/main.js",
    "plugin:prepare": "npm run build && node dist/scripts/prepare-plugin.js",
    "demo:mcp": "npm run build && node dist/scripts/demo-mcp.js",
    "eval:retrieval": "npm run build && node --expose-gc dist/scripts/evaluate-retrieval.js",
    "training:prepare": "npm run build && node dist/scripts/prepare-training.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "corpus:build": "npm run build && node dist/apps/ingestion-worker/src/build-corpus.js",
    "check:boundaries": "npm run build && node dist/scripts/check-boundaries.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "exceljs": "4.4.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
