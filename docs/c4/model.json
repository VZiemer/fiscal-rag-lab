{
  "name": "Fiscal RAG Lab",
  "elements": [
    { "id": "researcher", "kind": "person", "name": "Researcher", "technology": "Person", "description": ["Asks questions and reviews", "context and evidence."] },
    { "id": "client", "kind": "softwareSystem", "name": "MCP client / assistant", "technology": "External system", "description": ["Conducts conversations, calls tools", "and writes evidence-based answers."] },
    { "id": "official", "kind": "softwareSystem", "name": "Official sources", "technology": "External system · HTTPS", "description": ["Receita, NF-e, CONFAZ,", "SEFAZ-SP and SEF-MG.", "Maintenance downloads."] },
    { "id": "ollama", "kind": "softwareSystem", "name": "Ollama runtime", "technology": "External system · optional", "description": ["Learned embeddings, if configured.", "Not used by the current Lambda."] },
    { "id": "fiscal", "kind": "softwareSystem", "name": "Fiscal RAG Lab", "technology": "System of interest", "description": ["Retrieves tax codes and texts", "with source, edition and validity.", "Does not generate the LLM answer."] },
    { "id": "runtime", "kind": "container", "parent": "fiscal", "name": "MCP server + retrieval", "technology": "Node.js 22 · TypeScript", "description": ["One process: protocol, queries", "and in-memory indexes.", "Local: HTTP. AWS: Lambda."] },
    { "id": "ingest", "kind": "container", "parent": "fiscal", "name": "Ingestion worker", "technology": "Node.js · maintenance CLI", "description": ["Downloads, extracts and chunks.", "Produces corpus.json and reports.", "Runs separately from queries."] },
    { "id": "store", "kind": "container", "parent": "fiscal", "name": "Versioned corpus", "technology": "JSON files + snapshots", "style": "storage", "description": ["Text, codes, metadata and hashes.", "corpus.json is bundled with Lambda.", "Not a remote vector database."] },
    { "id": "site", "kind": "container", "parent": "fiscal", "name": "Page and policy", "technology": "HTML · S3 + CloudFront", "description": ["Static demo content.", "Does not execute MCP searches."] },
    { "id": "transport", "kind": "component", "parent": "runtime", "name": "MCP / HTTP adapter", "technology": "server.ts · lambda.ts", "description": ["Exposes four read-only tools.", "Validates and dispatches calls."] },
    { "id": "validation", "kind": "component", "parent": "runtime", "name": "Contracts and validation", "technology": "ObjectContract · Standard Schema", "description": ["Fields, formats and limits.", "Zod encapsulated in one module."] },
    { "id": "retrieval", "kind": "component", "parent": "runtime", "name": "HybridRetriever", "technology": "packages/retrieval", "description": ["Routes queries; filters jurisdiction", "and validity; combines through RRF", "and attaches related evidence."] },
    { "id": "corpus", "kind": "component", "parent": "runtime", "name": "MemoryCorpus", "technology": "CorpusRepository", "description": ["In-memory texts, provenance", "and relationships; lookup by ID."] },
    { "id": "codes", "kind": "component", "parent": "runtime", "name": "InMemoryFiscalRepository", "technology": "FiscalRuleRepository", "description": ["Exact CFOP/NCM lookup", "with editions and validity limits."] },
    { "id": "embeddings", "kind": "component", "parent": "runtime", "name": "HashEmbeddingProvider", "technology": "EmbeddingProvider · default", "description": ["Hash counts: 128 dimensions.", "No learned semantics."] },
    { "id": "lexical", "kind": "component", "parent": "runtime", "name": "Bm25Index", "technology": "Custom lexical index", "description": ["Inverted word lists", "and BM25 scoring."] },
    { "id": "vectors", "kind": "component", "parent": "runtime", "name": "BruteForceIndex", "technology": "VectorIndex · default", "description": ["Compares every vector", "using cosine similarity."] },
    { "id": "hybridClass", "kind": "code", "name": "HybridRetriever", "technology": "Consumer class", "description": ["create(...) / search(input)", "Receives VectorIndex by injection."] },
    { "id": "indexPort", "kind": "code", "name": "VectorIndex<T>", "technology": "Interface / port", "style": "port", "description": ["add(id, vector, payload)", "search(query, k) → SearchHit<T>[]", "size() → number"] },
    { "id": "exactClass", "kind": "code", "name": "BruteForceIndex<T>", "technology": "Class · active at endpoint", "description": ["Vector Map; exhaustive search.", "serialize() / deserialize()", "Restorable library snapshot."] },
    { "id": "ivfClass", "kind": "code", "name": "IvfIndex<T>", "technology": "Class · experiment", "style": "optional", "description": ["Custom K-Means forms groups.", "nlist / nprobe control search.", "May miss relevant neighbors."] },
    { "id": "hnswClass", "kind": "code", "name": "HnswIndex<T>", "technology": "Class · experiment", "style": "optional", "description": ["Layered neighbor graph.", "m / efConstruction / efSearch.", "May miss relevant neighbors."] },
    { "id": "cosine", "kind": "code", "name": "cosineSimilarity(a, b)", "technology": "Custom mathematical function", "description": ["Dot product divided by norms.", "A score is not tax certainty."] }
  ],
  "relationships": [
    { "id": "ask", "from": "researcher", "to": "client", "label": "Asks questions" },
    { "id": "systemCall", "from": "client", "to": "fiscal", "label": "Queries tools", "technology": "MCP / HTTPS" },
    { "id": "systemDownload", "from": "fiscal", "to": "official", "label": "Collects documents during maintenance", "technology": "HTTPS" },
    { "id": "systemEmbedding", "from": "fiscal", "to": "ollama", "label": "Requests vectors if configured", "technology": "Local HTTP / remote HTTPS", "optional": true },
    { "id": "mcpCall", "from": "client", "to": "runtime", "label": "Calls tools", "technology": "MCP / HTTPS" },
    { "id": "visit", "from": "client", "to": "site", "label": "Visits page and policy", "technology": "HTTPS" },
    { "id": "load", "from": "runtime", "to": "store", "label": "Reads corpus at startup" },
    { "id": "download", "from": "ingest", "to": "official", "label": "Downloads official editions", "technology": "HTTPS" },
    { "id": "write", "from": "ingest", "to": "store", "label": "Writes corpus and snapshots" },
    { "id": "validate", "from": "transport", "to": "validation", "label": "Validates input and output" },
    { "id": "search", "from": "transport", "to": "retrieval", "label": "search_regulations" },
    { "id": "lookup", "from": "transport", "to": "codes", "label": "get_cfop / get_ncm" },
    { "id": "explain", "from": "transport", "to": "corpus", "label": "explain_rule" },
    { "id": "routeCode", "from": "retrieval", "to": "codes", "label": "Routes complete codes" },
    { "id": "read", "from": "retrieval", "to": "corpus", "label": "Reads excerpts and relationships" },
    { "id": "embed", "from": "retrieval", "to": "embeddings", "label": "Embeds text and query" },
    { "id": "bm25", "from": "retrieval", "to": "lexical", "label": "Searches words" },
    { "id": "vector", "from": "retrieval", "to": "vectors", "label": "Searches vectors" },
    { "id": "usePort", "from": "hybridClass", "to": "indexPort", "label": "Depends on the port" },
    { "id": "exactPort", "from": "exactClass", "to": "indexPort", "label": "Implements", "implements": true },
    { "id": "ivfPort", "from": "ivfClass", "to": "indexPort", "label": "Implements", "implements": true },
    { "id": "hnswPort", "from": "hnswClass", "to": "indexPort", "label": "Implements", "implements": true },
    { "id": "exactCosine", "from": "exactClass", "to": "cosine", "label": "Computes cosine" },
    { "id": "ivfCosine", "from": "ivfClass", "to": "cosine", "label": "Computes cosine" },
    { "id": "hnswCosine", "from": "hnswClass", "to": "cosine", "label": "Computes cosine" }
  ],
