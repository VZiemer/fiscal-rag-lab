    { "id": "routeCode", "from": "retrieval", "to": "codes", "label": "Roteia código completo" },
    { "id": "read", "from": "retrieval", "to": "corpus", "label": "Lê trechos e relações" },
    { "id": "embed", "from": "retrieval", "to": "embeddings", "label": "Vetoriza textos e consulta" },
    { "id": "bm25", "from": "retrieval", "to": "lexical", "label": "Pesquisa palavras" },
    { "id": "vector", "from": "retrieval", "to": "vectors", "label": "Pesquisa vetores" },
    { "id": "usePort", "from": "hybridClass", "to": "indexPort", "label": "Depende da porta" },
    { "id": "exactPort", "from": "exactClass", "to": "indexPort", "label": "Implementa", "implements": true },
    { "id": "ivfPort", "from": "ivfClass", "to": "indexPort", "label": "Implementa", "implements": true },
    { "id": "hnswPort", "from": "hnswClass", "to": "indexPort", "label": "Implementa", "implements": true },
    { "id": "exactCosine", "from": "exactClass", "to": "cosine", "label": "Calcula cosseno" },
    { "id": "ivfCosine", "from": "ivfClass", "to": "cosine", "label": "Calcula cosseno" },
    { "id": "hnswCosine", "from": "hnswClass", "to": "cosine", "label": "Calcula cosseno" }
