{
  "name": "Fiscal RAG Lab",
  "elements": [
    { "id": "researcher", "kind": "person", "name": "Pessoa pesquisadora", "technology": "Pessoa", "description": ["Formula perguntas e confere", "o contexto e as evidências."] },
    { "id": "client", "kind": "softwareSystem", "name": "Cliente MCP / assistente", "technology": "Sistema externo", "description": ["Conduz a conversa, chama ferramentas", "e redige a resposta com evidências."] },
    { "id": "official", "kind": "softwareSystem", "name": "Fontes oficiais", "technology": "Sistema externo · HTTPS", "description": ["Receita, NF-e, CONFAZ,", "SEFAZ-SP e SEF-MG.", "Downloads de manutenção."] },
    { "id": "ollama", "kind": "softwareSystem", "name": "Runtime Ollama", "technology": "Sistema externo · opcional", "description": ["Embeddings aprendidos, se configurado.", "Não utilizado na Lambda atual."] },
    { "id": "fiscal", "kind": "softwareSystem", "name": "Fiscal RAG Lab", "technology": "Sistema de interesse", "description": ["Recupera códigos e textos fiscais", "com fonte, edição e vigência.", "Não gera a resposta final da LLM."] },
    { "id": "runtime", "kind": "container", "parent": "fiscal", "name": "Servidor MCP + recuperação", "technology": "Node.js 22 · TypeScript", "description": ["Um processo: protocolo, consultas", "e índices construídos em memória.", "Local: HTTP. AWS: Lambda."] },
    { "id": "ingest", "kind": "container", "parent": "fiscal", "name": "Worker de ingestão", "technology": "Node.js · CLI de manutenção", "description": ["Baixa snapshots; extrai e fragmenta.", "Produz corpus.json e relatórios.", "Executado fora das consultas."] },
    { "id": "store", "kind": "container", "parent": "fiscal", "name": "Acervo versionado", "technology": "Arquivos JSON + snapshots", "style": "storage", "description": ["Texto, códigos, metadados e hashes.", "corpus.json acompanha a Lambda.", "Não é um banco vetorial remoto."] },
    { "id": "site", "kind": "container", "parent": "fiscal", "name": "Página e política", "technology": "HTML · S3 + CloudFront", "description": ["Conteúdo estático da demonstração.", "Não executa a pesquisa MCP."] },
    { "id": "transport", "kind": "component", "parent": "runtime", "name": "Adaptador MCP / HTTP", "technology": "server.ts · lambda.ts", "description": ["Expõe quatro ferramentas de leitura.", "Valida e encaminha chamadas."] },
    { "id": "validation", "kind": "component", "parent": "runtime", "name": "Contratos e validação", "technology": "ObjectContract · Standard Schema", "description": ["Campos, formatos e limites.", "Zod encapsulado em um módulo."] },
    { "id": "retrieval", "kind": "component", "parent": "runtime", "name": "HybridRetriever", "technology": "packages/retrieval", "description": ["Roteia consulta; filtra jurisdição", "e vigência; combina por RRF", "e reúne evidências relacionadas."] },
    { "id": "corpus", "kind": "component", "parent": "runtime", "name": "MemoryCorpus", "technology": "CorpusRepository", "description": ["Textos, proveniência e relações", "em memória; acesso por ID."] },
    { "id": "codes", "kind": "component", "parent": "runtime", "name": "InMemoryFiscalRepository", "technology": "FiscalRuleRepository", "description": ["Consulta exata CFOP/NCM", "com versões e limites de vigência."] },
    { "id": "embeddings", "kind": "component", "parent": "runtime", "name": "HashEmbeddingProvider", "technology": "EmbeddingProvider · padrão", "description": ["Contagens por hash: 128 dimensões.", "Sem semântica aprendida."] },
    { "id": "lexical", "kind": "component", "parent": "runtime", "name": "Bm25Index", "technology": "Índice lexical próprio", "description": ["Listas invertidas de palavras", "e pontuação BM25."] },
    { "id": "vectors", "kind": "component", "parent": "runtime", "name": "BruteForceIndex", "technology": "VectorIndex · padrão", "description": ["Compara todos os vetores", "por similaridade de cosseno."] },
    { "id": "hybridClass", "kind": "code", "name": "HybridRetriever", "technology": "Classe consumidora", "description": ["create(...) / search(input)", "Recebe VectorIndex por injeção."] },
    { "id": "indexPort", "kind": "code", "name": "VectorIndex<T>", "technology": "Interface / porta", "style": "port", "description": ["add(id, vector, payload)", "search(query, k) → SearchHit<T>[]", "size() → number"] },
    { "id": "exactClass", "kind": "code", "name": "BruteForceIndex<T>", "technology": "Classe · ativa no endpoint", "description": ["Map de vetores; busca exaustiva.", "serialize() / deserialize()", "Snapshot restaurável da biblioteca."] },
    { "id": "ivfClass", "kind": "code", "name": "IvfIndex<T>", "technology": "Classe · experimento", "style": "optional", "description": ["K-Means próprio organiza grupos.", "nlist / nprobe controlam a busca.", "Pode perder vizinhos relevantes."] },
    { "id": "hnswClass", "kind": "code", "name": "HnswIndex<T>", "technology": "Classe · experimento", "style": "optional", "description": ["Grafo de vizinhos em camadas.", "m / efConstruction / efSearch.", "Pode perder vizinhos relevantes."] },
    { "id": "cosine", "kind": "code", "name": "cosineSimilarity(a, b)", "technology": "Função matemática própria", "description": ["Produto escalar dividido pelas normas.", "A pontuação não é certeza fiscal."] }
  ],
  "relationships": [
    { "id": "ask", "from": "researcher", "to": "client", "label": "Faz perguntas" },
